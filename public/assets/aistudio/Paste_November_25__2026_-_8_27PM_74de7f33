        title: "Tribunais Superiores & Leis Extravagantes",
        desc: "Domínio técnico em Lei de Drogas (11.343/06), ORCRIM (12.850/13), Lavagem (9.613/98), quebra de cadeia de custódia digital (Art. 158-A CPP) e nulidade de reconhecimento (Art. 226 CPP).",
        badge: "STJ / STF • Habeas Corpus & REsp"
      },
      {
        tag: "PILAR 05 • CERTIFICAÇÃO & DOUTOR LEX",
        icon: "fa-file-signature",
        title: "Agente Doutor LEX & Documentos Assinados",
        desc: "Converse caso a caso com o especialista criminal dedicado ao dossiê e exporte memoriais e roteiros com papel timbrado, selo ICP-Brasil/OAB e hash SHA-256 verificável.",
        badge: "Hash SHA-256 • Assinatura OAB"
      }
    ];

    let currentSlideIdx = 0;
    let carouselTimer = null;

    function renderCarouselSlide() {
      const slide = carouselSlides[currentSlideIdx];
      const bodyEl = document.getElementById('carousel-slide-body');
      const counterEl = document.getElementById('carousel-counter');
      const dotsEl = document.getElementById('carousel-dots');

      if (!bodyEl) return;
      counterEl.textContent = `0${currentSlideIdx + 1} / 0${carouselSlides.length}`;

      bodyEl.innerHTML = `
        <div class="space-y-4">
          <div class="w-12 h-12 rounded-2xl bg-amber-500/15 border border-amber-500/40 text-amber-400 flex items-center justify-center text-xl">
            <i class="fa-solid ${slide.icon}"></i>
          </div>
          <div class="text-[11px] font-mono-code text-amber-400 tracking-wider">${slide.tag}</div>
          <h3 class="font-cinzel text-xl sm:text-2xl font-bold text-chalk leading-snug">${slide.title}</h3>
          <p class="text-xs sm:text-sm text-slate-300 leading-relaxed">${slide.desc}</p>
        </div>
        <div class="pt-4">
          <span class="inline-flex items-center gap-2 px-3 py-1 rounded-lg bg-midnight-950/90 border border-amber-500/30 text-[11px] font-mono-code text-amber-300">
            <i class="fa-solid fa-check-double text-emerald-400"></i> ${slide.badge}
          </span>
        </div>
      `;

      dotsEl.innerHTML = carouselSlides.map((_, idx) => `
        <button onclick="goToSlide(${idx})" class="h-2 rounded-full transition-all ${idx === currentSlideIdx ? 'w-7 bg-amber-400' : 'w-2 bg-slate-600 hover:bg-slate-400'}" aria-label="Ir para slide ${idx + 1}"></button>
      `).join('');
    }

    function nextSlide() {
      currentSlideIdx = (currentSlideIdx + 1) % carouselSlides.length;
      renderCarouselSlide();
    }
    function prevSlide() {
      currentSlideIdx = (currentSlideIdx - 1 + carouselSlides.length) % carouselSlides.length;
      renderCarouselSlide();
    }
    function goToSlide(idx) {
      currentSlideIdx = idx;
      renderCarouselSlide();
    }
    function startCarousel() {
      if (carouselTimer) clearInterval(carouselTimer);
      carouselTimer = setInterval(nextSlide, 5500);
    }
    function pauseCarousel() {
      if (carouselTimer) clearInterval(carouselTimer);
    }
    function resumeCarousel() {
      startCarousel();
    }

    // =========================================================================
    // 3. MOCKED DATABASE (CASES, TIMELINES, MEDIA, NEWS & DEADLINES)
    // =========================================================================
    const initialCasesData = [
      {
