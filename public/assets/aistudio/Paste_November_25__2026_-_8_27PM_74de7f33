  <script>
    // =========================================================================
    // 1. THREE.JS 3D MOTION BACKGROUND (LANDING & LOGIN)
    // =========================================================================
    let scene, camera, renderer, particlesMesh, wireframeMesh;
    let mouseX = 0, mouseY = 0;
    let is3DActive = true;

    function init3DBackground() {
      try {
        const canvas = document.getElementById('bg-3d-canvas');
        if (!canvas || typeof THREE === 'undefined') return;

        scene = new THREE.Scene();
        camera = new THREE.PerspectiveCamera(60, window.innerWidth / window.innerHeight, 0.1, 1000);
        camera.position.z = 28;

        renderer = new THREE.WebGLRenderer({ canvas, alpha: true, antialias: true });
        renderer.setSize(window.innerWidth, window.innerHeight);
        renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));

        // Golden Particle Field
        const particleCount = 650;
        const geometry = new THREE.BufferGeometry();
        const positions = new Float32Array(particleCount * 3);

        for (let i = 0; i < particleCount * 3; i += 3) {
          positions[i] = (Math.random() - 0.5) * 70;
          positions[i + 1] = (Math.random() - 0.5) * 50;
          positions[i + 2] = (Math.random() - 0.5) * 40;
        }
        geometry.setAttribute('position', new THREE.BufferAttribute(positions, 3));

        const material = new THREE.PointsMaterial({
          color: 0xF59E0B,
          size: 0.22,
          transparent: true,
          opacity: 0.75
        });
        particlesMesh = new THREE.Points(geometry, material);
        scene.add(particlesMesh);

        // Sacred Geometric / Forensic Lattice Icosahedron
        const icoGeo = new THREE.IcosahedronGeometry(11, 1);
        const icoMat = new THREE.MeshBasicMaterial({
          color: 0xD97706,
          wireframe: true,
          transparent: true,
          opacity: 0.14
        });
        wireframeMesh = new THREE.Mesh(icoGeo, icoMat);
        wireframeMesh.position.set(9, 0, -4);
        scene.add(wireframeMesh);

        window.addEventListener('mousemove', (e) => {
          mouseX = (e.clientX / window.innerWidth - 0.5) * 2;
          mouseY = (e.clientY / window.innerHeight - 0.5) * 2;
        });

        window.addEventListener('resize', () => {
          if (!camera || !renderer) return;
          camera.aspect = window.innerWidth / window.innerHeight;
          camera.updateProjectionMatrix();
          renderer.setSize(window.innerWidth, window.innerHeight);
        });

        animate3D();
      } catch (err) {
        console.warn('WebGL fallback ativo:', err);
      }
    }

    function animate3D() {
      requestAnimationFrame(animate3D);
      if (!is3DActive || !renderer || !scene || !camera) return;

      if (particlesMesh) {
        particlesMesh.rotation.y += 0.0008;
        particlesMesh.rotation.x += 0.0003;
      }
      if (wireframeMesh) {
        wireframeMesh.rotation.y -= 0.0022;
        wireframeMesh.rotation.x += 0.0012;
        wireframeMesh.position.x += (9 + mouseX * 1.8 - wireframeMesh.position.x) * 0.04;
        wireframeMesh.position.y += (-mouseY * 1.5 - wireframeMesh.position.y) * 0.04;
      }
      renderer.render(scene, camera);
    }

    // =========================================================================
    // 2. LANDING CAROUSEL DATA & CONTROLS
    // =========================================================================
    const carouselSlides = [
      {
        tag: "PILAR 01 • INGESTÃO MULTIMODAL",
        icon: "fa-folder-tree",
        title: "Dossiê Vivo & Linha do Tempo Forense",
