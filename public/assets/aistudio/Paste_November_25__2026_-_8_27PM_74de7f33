      appState.activeWarRoomTab = tabKey;
      document.querySelectorAll('.wr-panel').forEach(p => p.classList.add('hidden'));
      document.querySelectorAll('.wr-tab-btn').forEach(b => {
        b.className = "wr-tab-btn px-4 py-2.5 rounded-xl text-xs font-semibold whitespace-nowrap transition-all bg-midnight-800 text-slate-300 border border-white/10 hover:border-amber-500/40";
      });

      const activePanel = document.getElementById(`wr-panel-${tabKey}`);
      const activeBtn = document.getElementById(`wr-tab-${tabKey}`);
