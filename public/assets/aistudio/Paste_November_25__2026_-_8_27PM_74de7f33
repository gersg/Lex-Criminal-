    function copyTextToClipboard(text, successMsg) {
      const textarea = document.createElement('textarea');
      textarea.value = text;
      textarea.style.position = 'fixed';
      textarea.style.opacity = '0';
      document.body.appendChild(textarea);
      textarea.select();
      try {
        document.execCommand('copy');
        showToast(successMsg || 'Texto copiado!', 'success');
      } catch (err) {
        showToast('Não foi possível copiar automaticamente.', 'error');
      }
      document.body.removeChild(textarea);
    }

    function showToast(message, type = 'success') {
      const container = document.getElementById('toast-container');
      const toast = document.createElement('div');
      const borderClass = type === 'error' ? 'border-red-500/50 text-red-200' : 'border-amber-500/50 text-amber-100';
      toast.className = `pointer-events-auto glass-gold px-4 py-3 rounded-xl border ${borderClass} text-xs font-medium shadow-xl flex items-center gap-2.5 transition-all duration-300`;
      toast.innerHTML = `
        <i class="fa-solid ${type === 'error' ? 'fa-circle-exclamation text-red-400' : 'fa-circle-check text-amber-400'}"></i>
        <span>${message}</span>
      `;
      container.appendChild(toast);
      setTimeout(() => {
        toast.style.opacity = '0';
        toast.style.transform = 'translateY(8px)';
        setTimeout(() => toast.remove(), 300);
      }, 3400);
    }

