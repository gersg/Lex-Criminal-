    function simulateMediaUpload() {
      const c = getActiveCase();
      const type = document.getElementById('upload-doc-type').value;
      const title = document.getElementById('upload-doc-title').value.trim() || (type === 'audio' ? 'Áudio de Entrevista Gravado no Fórum' : 'Certidão / Documento Juntado aos Autos');
      const customContent = document.getElementById('upload-doc-content').value.trim();

      const transcript = customContent || (type === 'audio'
        ? "Transcrição automática via Whisper Forense: O interlocutor confirma que não houve mandado judicial e ratifica o endereço fixo e vínculos familiares do assistido."
        : "Extração OCR concluída: Documento oficial conferido e vinculado às teses defensivas do dossiê para uso imediato pelo Doutor LEX.");

      c.media.unshift({
        id: 'm-' + Date.now(),
        type,
        title,
        date: 'Agora mesmo',
        transcript
      });

      document.getElementById('upload-doc-title').value = '';
      document.getElementById('upload-doc-content').value = '';
      persistAppState();
      renderWarRoomMedia(c);
      showToast('Arquivo processado e indexado na memória do Doutor LEX!', 'success');
    }

