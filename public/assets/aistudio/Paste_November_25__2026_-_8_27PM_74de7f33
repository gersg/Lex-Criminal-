      const sel = document.getElementById('warroom-case-select');
      if (!sel) return;
      sel.innerHTML = appState.cases.map(c => `
        <option value="${c.id}" ${c.id === appState.selectedCaseId ? 'selected' : ''}>${c.name} — ${c.crime}</option>
