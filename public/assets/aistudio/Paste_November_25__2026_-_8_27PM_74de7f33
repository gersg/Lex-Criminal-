      // Render Tab 2: Media & Docs
      renderWarRoomMedia(c);
      // Render Tab 3: Timeline
      renderWarRoomTimeline(c);
      // Render Tab 4: Lex Chat
      renderWarRoomLexChat(c);
      // Render Tab 5: Estratégia
      renderWarRoomStrategy(c);
      // Render Tab 6: Modo Fórum (Sem Teleprompter)
      renderWarRoomModoForum(c);
      // Render Tab 7: Export
      refreshAuthenticatedDocument();

      switchWarRoomTab(appState.activeWarRoomTab);
